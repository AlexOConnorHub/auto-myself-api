#!/bin/bash
set -euo pipefail
source .env

ARGS=("$@")
if [ ${#ARGS[@]} -eq 0 ]; then
  ARGS=("up")
fi

DB_URL="${POSTGRES_URL:-postgres:password@localhost:5432/appdb}"
SEP="?"
case "$DB_URL" in *\?*) SEP="&" ;; esac

docker run --rm -i \
  -v ./migrations/schema:/migrations \
  --network host \
  migrate/migrate \
  -path=/migrations \
  -database="postgres://${DB_URL}${SEP}sslmode=disable&search_path=public&x-migrations-table=_schema_migrations" \
  "${ARGS[@]}"
