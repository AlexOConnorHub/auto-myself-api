#/bin/bash
source .env

ARGS=("$@")
if [ ${#ARGS[@]} -eq 0 ]; then
  ARGS=("up")
fi

docker run --rm \
  -v ./migrations/seed:/migrations \
  --network host \
  migrate/migrate \
  -path=/migrations \
  -database="postgres://${POSTGRES_URL:-postgres:password@localhost:5432/appdb\?sslmode=disable}&search_path=public&x-migrations-table=_seed_migrations" \
  "${ARGS[@]}"